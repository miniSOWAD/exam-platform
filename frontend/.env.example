# Browser requests always use the same-origin /api/v1 proxy.
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-side FastAPI origin. Defaults to the ExamFlow Cloud API if omitted.
# For local backend development, change this to http://localhost:8000.
API_INTERNAL_URL=https://examflow-api.fastapicloud.dev/
