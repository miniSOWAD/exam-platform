# Copy this file to backend/.env for local development.
# Never commit backend/.env or paste real credentials into source code.
APP_NAME=ExamFlow API
APP_ENV=development
API_V1_PREFIX=/api/v1

# Local Docker PostgreSQL. For deployment, replace with Neon pooled connection URL.
# Neon example: postgresql+psycopg://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require
DATABASE_URL=postgresql+psycopg://examuser:localdevpassword@db:5432/examdb
DATABASE_ECHO=false
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=1
DB_POOL_RECYCLE_SECONDS=300
DB_CONNECT_TIMEOUT_SECONDS=15
DB_COMMAND_TIMEOUT_SECONDS=30
CHECK_DATABASE_ON_STARTUP=true

# Use a newly generated random secret (at least 32 bytes).
JWT_SECRET=REPLACE_WITH_A_NEW_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=720

# Exact public frontend origin(s), comma-separated.
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false

# Cloudinary credentials are server-only. Never use NEXT_PUBLIC_ for these.
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET
CLOUDINARY_FOLDER=examflow

# Strict 300 KiB profile image cap. Supported formats: JPG, PNG, WebP.
MAX_UPLOAD_BYTES=307200
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/jpg

# Used by: python -m app.seed_admin (only during first setup).
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Md Mahruf Alam
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_ADMIN_PASSWORD
